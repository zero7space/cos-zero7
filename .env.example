# ==============================================================================
# COS Theta (Zero7 CRM) — Environment Configuration Template
# Copy this file to .env and fill in the values before deploying to production.
# ==============================================================================

# --- Application Server ---
PORT=8000
APP_DOMAIN=cos.zero7.space
ZERO7_ROOT_DOMAIN=zero7.space
JWT_SECRET=replace_with_a_secure_random_hex_string_in_production

# --- Database Configuration ---
# Leave DATABASE_URL commented or empty to default to SQLite (zero7_crm.db).
# In production with Docker Compose or managed PostgreSQL (Supabase / RDS):
DATABASE_URL=postgresql://zero7_admin:change_me_production_password@postgres:5432/zero7_crm

# If migrating an existing zero7_crm.db into PostgreSQL on first boot:
AUTO_MIGRATE_SQLITE_TO_POSTGRES=0

# PostgreSQL Docker Container Credentials (used by docker-compose)
POSTGRES_DB=zero7_crm
POSTGRES_USER=zero7_admin
POSTGRES_PASSWORD=change_me_production_password

# --- OmniRoute Dedicated AI Model Gateway (OpenAI & Anthropic Compatible) ---
OPENAI_BASE_URL=http://100.101.21.96:20128/v1
OPENAI_API_KEY=sk-8ed5097214e7accd-138ead-df38f3ce
ANTHROPIC_BASE_URL=http://100.101.21.96:20128
ANTHROPIC_API_KEY=sk-8ed5097214e7accd-138ead-df38f3ce

# Multi-Tier Routing Endpoints (Tailscale Mesh -> Local LAN -> Cloudflare Tunnel)
OMNIROUTE_PRIMARY_URL=http://100.101.21.96:20128/v1
OMNIROUTE_LAN_URL=http://192.168.1.11:20128/v1
OMNIROUTE_TUNNEL_URL=https://conditioning-baskets-vip-christ.trycloudflare.com/v1
OMNIROUTE_LOCAL_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-8ed5097214e7accd-138ead-df38f3ce

# Legacy Fallback Gateway
AI_API_BASE=http://168.144.91.0:8080/v1
AI_API_KEY=sk-bd99f718ae7d4f35bb4ecc22c1e5780c

# --- GitHub Integration (Client Vaults & CI) ---
GITHUB_TOKEN=ghp_example_token_with_repo_scope

# --- Hostinger DNS Automation ---
HOSTINGER_API_TOKEN=

# --- Speech & Transcription (Deepgram) ---
DEEPGRAM_API_KEY=

# --- Google Drive & Google Tasks ---
# Place service account JSON in ./google_drive_credentials.json or set path:
GOOGLE_APPLICATION_CREDENTIALS=/app/google_drive_credentials.json

# --- Meta Ads & Lead Webhook ---
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=1256505504219421
META_VERIFY_TOKEN=zero7_meta_verify_2026

# --- Zoho Mail Integration ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REDIRECT_URI=https://cos.zero7.space/api/mail/callback
